# --- Supabase (auth + entitlements DB) ---
# Already provisioned — see chat for the project. Dashboard: https://supabase.com/dashboard/project/wijnzuwcluzalvpobpbr
NEXT_PUBLIC_SUPABASE_URL=https://wijnzuwcluzalvpobpbr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_UV63jgZYR50-clb1she4UA_b1ybjSMf
# Secret — grab from Supabase dashboard > Project Settings > API > service_role key.
# NEVER expose this to the browser or commit it. Used only in webhook handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (India checkout) ---
# Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Subscriptions > Plans — create a recurring monthly plan first
RAZORPAY_PLAN_ID=
# Dashboard > Settings > Webhooks — you choose this value when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Dodo Payments (international checkout) ---
# Dashboard > Developer > API Keys
DODO_PAYMENTS_API_KEY=
# "test_mode" while testing, "live_mode" once ready for real customers
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Dashboard > Products — create your subscription product first
DODO_PRODUCT_ID=
# Dashboard > Developer > Webhooks — copy the signing secret shown when you create the endpoint
DODO_PAYMENTS_WEBHOOK_KEY=

# --- App ---
# Used in Dodo's return_url. Set to your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
